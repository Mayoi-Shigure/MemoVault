# Copy to .env for local development. Never commit the populated .env.
# Use production on the HTTPS server to enable Secure session cookies.
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
# Use a dedicated database account in production.
DB_USER=root
DB_NAME=memovault
# Enter your own local MySQL password; there is no default password.
DB_PASSWORD=
# Generate a strong random value with Python secrets.token_urlsafe(48).
# Keep it stable across local restarts. Never use a sample/test password here.
SESSION_SECRET=

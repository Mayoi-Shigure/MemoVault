# Python cache
__pycache__/
*.pyc

# Environment variables / secrets
.env
.env.*
!.env.example
.venv/
venv/
.pytest_cache/

# IDE / editor
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

